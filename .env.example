# Contact form — required on Vercel (Settings → Environment Variables → Production)
# Local API testing: npx vercel dev  (plain npm run dev does NOT serve /api/contact)
#
# 1. Create account at https://resend.com
# 2. Add these three variables in Vercel, then redeploy

RESEND_API_KEY=re_xxxxxxxxxxxx

# Inbox that receives portfolio messages
CONTACT_TO_EMAIL=c.dhamdhere@somaiya.edu

# Sender — use onboarding@resend.dev until cdhamdhere.xyz is verified in Resend
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# After domain verification, switch to:
# CONTACT_FROM_EMAIL=Portfolio <hello@cdhamdhere.xyz>
