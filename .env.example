# Contact form (Vercel → Settings → Environment Variables)
# Get an API key at https://resend.com — free tier works for portfolio volume.
RESEND_API_KEY=re_xxxxxxxxxxxx

# Where you receive contact notifications
CONTACT_TO_EMAIL=c.dhamdhere@somaiya.edu

# After verifying your domain in Resend, use e.g. Portfolio <hello@cdhamdhere.xyz>
# Until then, Resend's sandbox sender works for testing:
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
